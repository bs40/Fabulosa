<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Fabulosa</AssemblyName>
    <RootNamespace>Fabulosa</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Fabulosa.ico</ApplicationIcon>
    <Version>3.2.0</Version>
    <Authors>Fabulosa</Authors>
    <Product>Fabulosa</Product>
    <Description>Music-reactive visualiser for Windows</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.9" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Artwork lives in the repository root so it can be swapped without touching the project. -->
    <EmbeddedResource Include="..\..\wordmark.png" LogicalName="Fabulosa.Images.Wordmark" />
    <EmbeddedResource Include="..\..\stickanim.png" LogicalName="Fabulosa.Images.StickAnim" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\dancer.mp4')">
    <!-- The dancer clip is copied beside the exe, never bundled into it; without the file the stick figure simply stays. -->
    <None Include="..\..\dancer.mp4" Link="dancer.mp4" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
