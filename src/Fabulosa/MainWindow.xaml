<Window x:Class="Fabulosa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Fabulosa"
        Width="1672" Height="941" MinWidth="836" MinHeight="470"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#080A08" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root" Background="#080A08">
        <skia:SKElement x:Name="Surface" PaintSurface="OnPaintSurface" />
    </Grid>
</Window>
